{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "files": {
    "includes": ["**", "!**/build", "!**/coverage", "!**/node_modules", "!**/package.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noDefaultExport": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noConsole": { "level": "off", "options": { "allow": ["log"] } }
      },
      "correctness": {
        "noNodejsModules": "off"
      },
      "performance": { "noBarrelFile": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
